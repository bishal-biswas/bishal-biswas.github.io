# Copy to .env for local development. Everything here is PUBLIC - it is baked
# into the built HTML/JS. Real secrets belong in the Apps Script project.
#
# In production set the same names as GitHub repository *variables*
# (Settings > Secrets and variables > Actions > Variables) - .github/workflows/
# deploy.yml passes them into the build.

# The /exec URL of the Apps Script web app. Leave blank and every form falls
# back to a "not connected yet" notice instead of failing.
PUBLIC_SHEETS_ENDPOINT=

# Optional. Must match CONFIG.API_TOKEN in google-apps-script/Code.gs.
# A speed bump against bots hitting the endpoint directly, not authentication.
PUBLIC_API_TOKEN=

# Optional. Set all three to send the contact form's auto-reply through
# EmailJS; leave them blank and Apps Script sends it instead.
PUBLIC_EMAILJS_PUBLIC_KEY=
PUBLIC_EMAILJS_SERVICE_ID=
PUBLIC_EMAILJS_AUTOREPLY_TEMPLATE_ID=

# Set to "false" to stop /testimonials fetching approved reviews at runtime.
PUBLIC_LIVE_TESTIMONIALS=true
