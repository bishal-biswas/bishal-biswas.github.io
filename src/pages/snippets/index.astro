---
import { getCollection } from "astro:content";
import PlainLayout from "../../layouts/PlainLayout.astro";
import CardCodeResource from "../../components/Card_CodeResource.astro";
import { pageData } from "../../data/site-data/pageData";

const codeEntries = await getCollection('code-help');
const publishedSnippets = codeEntries.filter((entry) => !entry.data.isDraft);

// Topics come from the snippets themselves, most-used first, so adding a
// tag in the CMS updates this list with no code change.
const tagCounts = new Map<string, number>();
for (const entry of publishedSnippets) {
    for (const tag of entry.data.tags ?? []) {
        tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
    }
}
const topics = [...tagCounts.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));

const pageContent = pageData.filter(page => page.pageTitle == "Snippets")[0];

---

<PlainLayout
    title="Code Snippets"
    metaDescription="A searchable collection of reusable code snippets for C#, .NET, JavaScript, SQL and web development."
    pageType="project"
    pageSmallTextBelow = {pageContent.pageSmallText}
    pageHeadingText= {pageContent.pageHeadingText}
    pageMainHeadingtagType="h1"
    backgroundImgClass={pageContent.backgroundImageClass}
    backgroundImg={pageContent.backgroundImage}
    isLargeWidth={true}
>
    <!--  https://framerusercontent.com/images/hREJN8AsFEbJPz6GtPdzL1hLkvc.png  -->

    <div class="codeArticles-container relative flex  flex-col my-5 gap-3"><!-- add lg:flex-row to make it sidebar -->

        <div class="sidebar lg:sticky top-24 flex flex-col gap-2 p-5 dark:bg-dark-teal bg-dark-teal rounded-xl w-full h-fit shadow-lg shadow-body-bg-2 animate-on-scroll"> <!-- add lg:w-[20%] to make it sidebar -->
            <div class="searchBox w-full flex justify-center items-center">
                <form
                    id="snippetSearchForm"
                    action="/search"
                    name="searchPanel"
                    class="relative flex gap-3 items-center w-full">
                    <input
                        required=""
                        type="text"
                        name="q"
                        id="snippetSearchInput"
                        autocomplete="off"
                        placeholder="Search snippets.."
                        class="w-full p-3 pl-6 hover:p-4 transition-all ease-in-out duration-200 outline-none dark:text-white text-body-bg rounded-full backdrop-blur-sm shadow-xl dark:placeholder:text-gray-300 placeholder:text-gray-800 bg-[#cbd5e198]"
                    />
                    <button
                        type="submit"
                        class="absolute right-2 hover:bg-dark-green bg-lite-green rounded-full size-10"
                    >
                        <i class="fa-solid fa-magnifying-glass text-white"></i>
                    </button>
                </form>
            </div>

            <span class="text-sm font-semibold text-gray-400">Topics</span>
            <ul id="topicCloud" class="flex flex-wrap gap-1 text-xs">
                <li>
                    <button type="button" data-tag="" aria-pressed="true"
                        class="topic-chip tag border border-[#587691d7] shadow shadow-[#587691d7] px-2 py-[2px] bg-[#183550d7] text-[#58ded6] rounded-full cursor-pointer transition-all">
                        Show All
                    </button>
                </li>
                {
                    topics.map(([tag, count]) => (
                        <li>
                            <button type="button" data-tag={tag.toLowerCase()} aria-pressed="false"
                                class="topic-chip tag border border-[#183550d7] px-2 py-[2px] bg-[#183550d7] text-[#58ded6] rounded-full cursor-pointer transition-all">
                                #{tag} <span class="opacity-60">{count}</span>
                            </button>
                        </li>
                    ))
                }
                {topics.length === 0 && <li class="text-gray-400">No topics yet</li>}
            </ul>
        </div>

        <div class="code-articles lg:w-[80%] w-full flex-wrap flex gap-3">
            {
                publishedSnippets.map((code)=>(
                    <CardCodeResource
                        cardTitle={code.data.title}
                        cardUrl={code.data.slug || ""}
                        descriptionText={code.data.metaDescription}
                        tags={code.data.tags}/>
                ))
            }
            <p id="snippetNoResults" class="hidden w-full text-center py-10 opacity-70">
                No snippets match your search.
            </p>
        </div>
    </div>
</PlainLayout>

<script is:inline>
    // Client-side filtering for /snippets: live text search plus topic chips.
    // Everything is already in the DOM (server-rendered), so this only shows
    // and hides - no fetching, and it degrades to the full list without JS.
    (function () {
        const form = document.getElementById("snippetSearchForm");
        const input = document.getElementById("snippetSearchInput");
        const cloud = document.getElementById("topicCloud");
        const noResults = document.getElementById("snippetNoResults");
        const cards = Array.from(document.querySelectorAll("[data-snippet-card]"));
        if (!input || !cards.length) return;

        const ACTIVE = ["border-[#587691d7]", "shadow", "shadow-[#587691d7]"];
        let activeTag = "";

        function apply() {
            const query = input.value.trim().toLowerCase();
            let visible = 0;

            for (const card of cards) {
                const haystack = card.dataset.search || "";
                const tags = (card.dataset.tags || "").split("|").filter(Boolean);
                const matchesText = !query || haystack.includes(query);
                const matchesTag = !activeTag || tags.includes(activeTag);
                const show = matchesText && matchesTag;
                card.classList.toggle("hidden", !show);
                if (show) visible++;
            }

            if (noResults) noResults.classList.toggle("hidden", visible > 0);
        }

        // Filter as you type. `input` also catches paste and clearing.
        input.addEventListener("input", apply);
        input.required = false;

        // Keep the form for no-JS users, but handle Enter here instead of
        // bouncing to the global search page.
        if (form) form.addEventListener("submit", (e) => { e.preventDefault(); apply(); });

        // Escape clears the box.
        input.addEventListener("keydown", (e) => {
            if (e.key === "Escape") { input.value = ""; apply(); }
        });

        if (cloud) {
            cloud.addEventListener("click", (e) => {
                const chip = e.target.closest(".topic-chip");
                if (!chip) return;
                const tag = chip.dataset.tag || "";
                // Clicking the active chip clears the filter.
                activeTag = tag === activeTag ? "" : tag;

                for (const c of cloud.querySelectorAll(".topic-chip")) {
                    const on = (c.dataset.tag || "") === activeTag;
                    c.setAttribute("aria-pressed", String(on));
                    c.classList.toggle("border-[#587691d7]", on);
                    c.classList.toggle("shadow", on);
                    c.classList.toggle("shadow-[#587691d7]", on);
                    c.classList.toggle("border-[#183550d7]", !on);
                }
                apply();
            });
        }

        // Support /snippets?q=foo and /snippets?tag=bar as entry points.
        const params = new URLSearchParams(window.location.search);
        if (params.get("q")) input.value = params.get("q");
        if (params.get("tag")) {
            const wanted = params.get("tag").toLowerCase();
            const chip = cloud && cloud.querySelector(`.topic-chip[data-tag="${CSS.escape(wanted)}"]`);
            if (chip) chip.click();
        }
        apply();
    })();
</script>
