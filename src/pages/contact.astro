---
import ColumnLayout from "../layouts/ColumnLayout.astro";
import Cards_ContactLinks from "../components/Cards_ContactLinks.astro";
import SectionDivider from "../components/SectionDivider.astro";
import ContactForm from "../components/ContactForm.astro";
---

<ColumnLayout
    title="Contact - Bishal Biswas"
    pageSmallText = "Contact Me"
    pageHeadingText = "Have a question? Let's Get in Touch"
    pageMainHeadingtagType = "h1" 
    isBreadcrumbShown = {true}>

    <div class="linksCards-holder w-full flex flex-wrap gap-3 lg:flex-row flex-col justify-evenly items-center mb-5">
        <Cards_ContactLinks cardIconClass="fa-duotone fa-envelope-open-text" cardTitle="Email">
            <ul>
                <li class="my-2"><a class="hover:text-[#70ba65]" href="mailto:bishal.biswas.4796@gmail.com">bishal.biswas.4796@gmail.com</a></li>
            </ul>
        </Cards_ContactLinks>
        <Cards_ContactLinks cardIconClass="fa-duotone fa-globe" cardTitle="Social Media">
            <ul class="socials flex gap-5 flex-wrap text-4xl">
                <li><a class="hover:text-[#70ba65]" href=""><i class="fab fa-facebook"></i></a></li>
                <li><a class="hover:text-[#70ba65]" href=""><i class="fab fa-twitter"></i></a></li>
                <li><a class="hover:text-[#70ba65]" href=""><i class="fab fa-linkedin"></i></a></li>
                <li><a class="hover:text-[#70ba65]" href=""><i class="fab fa-github"></i></a></li>
            </ul>
        </Cards_ContactLinks>
    </div>

    <div class="contactForm mt-14 w-full animate-on-scroll">
        <span class="heading-wrapper flex items-center relative border-t border-[#919ca1] border-dotted">
            <h2 class="absolute text-xl font-bold pr-4 z-[1] dark:bg-body-bg-2 bg-body-bg-2">Write your message</h2>
        </span>
        <ContactForm />
        
    </div>

    <SectionDivider></SectionDivider>
</ColumnLayout>