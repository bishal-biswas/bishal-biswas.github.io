export const getStaticPaths = (async () => {
  let allBlogPosts = await getCollection('article');
  allBlogPosts = filterFuturePosts(allBlogPosts);
  return allBlogPosts.map((entry) => {
    return {
      params: { slug: entry.data.slug },
      props: {  entry },
    };
  });
}) satisfies GetStaticPaths;

const BlogPosts = await getCollection('article');

interface navButtons {
    data : {
        title:string,
        slug:string,
    }
}
let nextArticle : navButtons = {
    data : {
        title:"",
        slug:"",
    }
};
let previousArticle : navButtons = {
    data : {
        title:"",
        slug:"",
    }
};

const { entry } = Astro.props;

BlogPosts.sort((a, b) => new Date(b.data.publishDate).valueOf() - new Date(a.data.publishDate).valueOf());

BlogPosts.map(function (article, i) {
    if (article.data.title == entry.data.title) {
        if (i > 0) {
            previousArticle.data.title = BlogPosts[i - 1].data.title;
            previousArticle.data.slug = BlogPosts[i - 1].data.slug || "";
        }
        if ((i+1) < BlogPosts.length) {
            nextArticle.data.title = BlogPosts[i + 1].data.title;
            nextArticle.data.slug = BlogPosts[i + 1].data.slug || "";
        }
    }
});


// Prefer the article's own opening as the meta description - a generated
// "X by Y on Z" line tells a searcher nothing. Falls back to that line if the
// body is too short to make a usable excerpt.
const plainBody = (entry.body ?? "")
    .replace(/```[\s\S]*?```/g, " ")
    .replace(/`[^`]*`/g, " ")
    .replace(/!\[[^\]]*\]\([^)]*\)/g, " ")
    .replace(/\[([^\]]*)\]\([^)]*\)/g, "$1")
    .replace(/<[^>]+>/g, " ")
    .replace(/^\s*[#>*_~-]+\s*/gm, "")
    .replace(/\s+/g, " ")
    .trim();
const articleDescription = plainBody.length > 80
    ? plainBody.slice(0, 155).replace(/\s+\S*$/, "") + "…"
    : `${entry.data.title} - an article by ${entry.data.author} on ${entry.data.category}.`;

---

<PlainLayout
  isSwiperRequired={true}
  isBreadcrumbShown={true}
  pageMainHeadingtagType="h1"
  isMainHeadingDoubleLined={true}
  isHeadContentAbove={true}
  pageHeadingText={entry.data.title}
  pageSmallText=""
  isLargeWidth={true}
  title={entry.data.title}
  backgroundImg={getPaths("Article") + entry.data.featuredImage}
  pageType="article"
  ogType="article"
  ogImage={getPaths("Article") + entry.data.featuredImage}
  heroImgTransitionName={`article-image-${entry.data.slug}`}
  metaDescription={articleDescription}
>
    <link rel="stylesheet" href="/assets/styles/prism.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fancyapps/ui@5.0/dist/fancybox/fancybox.css"/>

    <div slot="heroSection" class="article-info-top flex justify-center items-center gap-5" >
        <span title="Published on" class="articleDate flex gap-3 items-center rounded-tr-lg rounded-tl-lg" >
            <i class="fa-solid fa-calendar-days"></i>
            <span class="date">{getFormattedDate(entry.data.publishDate)}</span>
        </span>
        <span title="Reading Time" class="articleDate flex gap-3 items-center rounded-tr-lg rounded-tl-lg">
            <i class="fa-regular fa-clock"></i>
            <span id="readingTime" class="readingTime">{calculateReadingTime(entry.body?.replaceAll("#", "") ?? "")}</span>
        </span>
        {
            (entry.data.views) &&
            <span title="Visits" class="articleDate flex gap-3 items-center rounded-tr-lg rounded-tl-lg" >
                <i class="fa-duotone fa-eye"></i>
                <span class="">{entry.data.views} Views</span>
            </span>
        }
    </div>
    
    <!-- Article Container -->
    <div class="articlesContainer flex flex-col lg:flex-row w-full gap-3">
        <BlogContent post={entry as never} set:html={entry.rendered?.html}/>
        
        <ArticleSidebar />
    </div>
    
    <SectionDivider />
    
    <ArticleNavigationBottom {nextArticle} {previousArticle} />
    
    <ArticleBottomRelatedPostsCarousal ignoreArticle={entry.data.title} category={entry.data.category.toString()} />
    
    <ArticleBottomAllCategories />

</PlainLayout>

<script is:inline src="https://cdn.jsdelivr.net/npm/@fancyapps/ui@5.0/dist/fancybox/fancybox.umd.js"></script>
<script is:inline>
    // Function to decode HTML entities
    function decodeHtmlEntities(str) {
        const textArea = document.createElement("textarea");
        textArea.innerHTML = str;
        return textArea.value;
    }

    // Update captions for Fancybox
    document.querySelectorAll("[data-fancybox]").forEach((element) => {
        const encodedCaption = element.getAttribute("data-caption");
        if (encodedCaption) {
            const decodedCaption = decodeHtmlEntities(encodedCaption);
            element.setAttribute("data-caption", decodedCaption); // Update the attribute
        }
    });

    Fancybox.bind('[data-fancybox]', {
      //
    });    
</script>
<script is:inline src="/assets/scripts/prism.js"></script>
<script is:inline>
    TOCGenerator();

</script>
<style is:inline>
    div.code-toolbar > .toolbar > .toolbar-item > a, div.code-toolbar > .toolbar > .toolbar-item > button, div.code-toolbar > .toolbar > .toolbar-item > span{
        padding: .7em;
    }
    pre p {
        display: none;
    }
</style>