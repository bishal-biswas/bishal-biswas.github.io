---
import PlainLayout from "../../../layouts/PlainLayout.astro";
import BlogArticleCards from "../../../components/BlogArticleCards.astro";
import HeadingText from "../../../components/headingText.astro";
import ArticlePagination from "../../../components/ArticlePagination.astro";
import SectionDivider from "../../../components/SectionDivider.astro";
import ArticleBottomAllCategories from "../../../components/ArticleBottomAllCategories.astro";
import { getCollection, type CollectionEntry } from "astro:content";
import { filterFuturePosts } from "../../../data/utils";

let allBlogPosts2 = await getCollection("article");
allBlogPosts2 = filterFuturePosts(allBlogPosts2);

let count : number =0;
export async function getStaticPaths() {

    const allBlogPosts = await getCollection("article");
    allBlogPosts.sort(
        (a, b) =>
            new Date(b.data.publishDate).valueOf() -
            new Date(a.data.publishDate).valueOf(),
    );
    var categAllArticles: string[] = [];
    for (let i = 0; i < allBlogPosts.length; i++){
        categAllArticles.push(allBlogPosts[i].data.category);
    }

    const uniqueArr = [...new Set(categAllArticles)];

    return uniqueArr.map((entry) => ({
        params: { slug: entry.toLocaleLowerCase().replaceAll(" ", "-") },
        props: { entry },
    }));
}

const { entry } = Astro.props;

---

<PlainLayout
    isBreadcrumbShown={true}
    pageMainHeadingtagType="h1"
    isMainHeadingDoubleLined={true}
    metaDescription={`All articles filed under ${entry} on bishal-biswas.github.io, covering tutorials, notes and walkthroughs.`}
    pageHeadingText=`Articles related to "${entry}"`
    pageSmallText="Articles"
    title=`Articles related to ${entry}`
>
    <!-- Article Container -->
    <div class="articlesContainer lg:mt-24 mt-20 w-full">
        <HeadingText headText=`"${entry}" articles` TagType="span" />
        <div class="blog-container flex flex-wrap justify-start items-center w-full my-10 gap-5">
            {
                allBlogPosts2.map((post: any) => (
                    (post.data.category == entry) &&
                    <BlogArticleCards {post} />
                ))
            }
        </div>
    </div>

    <SectionDivider />

    <ArticleBottomAllCategories />
</PlainLayout>