---
import { globalStats } from "../data/site-data/profile";

import ColumnLayout from "../layouts/ColumnLayout.astro";
import HeroLinks from "../components/HeroLinks.astro";
import PraiseCards from "../components/PraiseCards.astro";
import VideoBio from "../components/VideoBio.astro";
import AboutText from "../components/AboutText.astro";
import ServicesCards from "../components/ServicesCards.astro";
import ButtonLinkUI from "../components/ButtonLinkUI.astro";
import { getPaths } from "../data/utils";
import { pageData } from "../data/site-data/pageData";
import { personalFiles } from "../data/site-data/personalFiles";

const pageContent = pageData.filter(page => page.pageTitle == "Home")[0];

---

<ColumnLayout 
    title="Bishal Biswas | Portfolio, .Net Developer, Web Developer, Blogger"
    metaDescription="Portfolio and blog of Bishal Biswas, a .NET and web developer from Kolkata. Browse recent projects, articles and reusable code snippets."
    pageSmallText = {pageContent.pageSmallText}
    pageHeadingText = {pageContent.pageHeadingText}
    pageMainHeadingtagType = "h1" 
    isMainHeadingDoubleLined = {true}
    backgroundImg={pageContent.backgroundImage}
    >
    
    <HeroLinks position="left" Classes="gap-3 my-10 lg:justify-normal justify-center" slot="heroSection">

        <ButtonLinkUI action="/portfolio">Recent Work</ButtonLinkUI>
        {
            personalFiles.resumePDF &&
            <ButtonLinkUI action={personalFiles.resumePDF} iconClass="fa-solid fa-file">Download Resume</ButtonLinkUI>

        }
        
    </HeroLinks>
    
    <div class="praiseCards-holder w-full flex flex-wrap gap-3 justify-evenly items-center mb-5">
        {globalStats.map((cards) =>
            <PraiseCards 
                iconClass={cards.iconClass}
                value={cards.value}
                textData={cards.textData}>
            </PraiseCards>)}
    </div>
    
    <VideoBio />

	<AboutText />

    <ServicesCards />
    
</ColumnLayout>
