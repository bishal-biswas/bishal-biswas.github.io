---
import ToolShell from "../../components/ToolShell.astro";
---

<ToolShell
    slug="json-yaml-converter"
    title="JSON to YAML & YAML to JSON Converter Online Free"
    metaDescription="Convert JSON to YAML and YAML to JSON online for free. Two-way converter for config files, Kubernetes manifests and CI pipelines - runs fully in your browser."
    pageHeadingText="JSON ↔ YAML Converter"
>
    <div slot="tool" class="tool-grid2">
        <div class="flex flex-col gap-3">
            <label class="tool-label" for="jy-json">JSON</label>
            <textarea id="jy-json" class="tool-input" placeholder='{"app":{"name":"demo","replicas":3}}' spellcheck="false"></textarea>
            <div class="tool-row">
                <button id="jy-tojaml" class="tool-btn">JSON → YAML <i class="fa-solid fa-arrow-right"></i></button>
            </div>
        </div>
        <div class="flex flex-col gap-3">
            <label class="tool-label" for="jy-yaml">YAML</label>
            <textarea id="jy-yaml" class="tool-input" placeholder={`app:\n  name: demo\n  replicas: 3`} spellcheck="false"></textarea>
            <div class="tool-row">
                <button id="jy-tojson" class="tool-btn"><i class="fa-solid fa-arrow-left"></i> YAML → JSON</button>
            </div>
        </div>
    </div>
    <p slot="tool" id="jy-msg" class="tool-error hidden" style="margin-top:.75rem"></p>

    <h2>Convert between JSON and YAML online</h2>
    <p>
        This two-way <strong>JSON ↔ YAML converter</strong> translates data in either direction with one click.
        Paste JSON on the left to get clean, indented YAML - or paste YAML on the right to get valid JSON. It's built
        for the formats you meet every day: Kubernetes manifests, Docker Compose files, GitHub Actions workflows,
        OpenAPI specs and application config.
    </p>

    <h2>JSON vs YAML - when to use which?</h2>
    <p>
        <strong>JSON</strong> is the universal machine format: strict, fast to parse and supported natively by every
        language. <strong>YAML</strong> is a superset designed for humans: no braces or quotes required, comments
        allowed, and indentation expresses structure. Configuration that people edit by hand (CI pipelines,
        infrastructure-as-code) tends to be YAML; data exchanged between programs tends to be JSON. Since every JSON
        document is also valid YAML, converting between them is lossless for standard data types.
    </p>

    <h2>Supported YAML features</h2>
    <ul>
        <li>Nested mappings and block-style lists with any indentation depth.</li>
        <li>Inline flow syntax like <code>[1, 2, 3]</code> and <code>{"{"}a: 1{"}"}</code>.</li>
        <li>Scalars: strings (quoted and plain), numbers, booleans, <code>null</code> / <code>~</code>.</li>
        <li>Comments (<code>#</code>) - stripped on conversion, as JSON has no comment syntax.</li>
    </ul>
    <p>
        The converter is written in plain JavaScript and runs entirely offline in your browser - safe for config files
        containing secrets. For advanced YAML features like anchors, aliases and multi-document streams, use a full
        parser in your toolchain. Need to tidy the JSON side? Use the
        <a href="/tools/json-formatter">JSON formatter</a>.
    </p>

    <script is:inline>
    (function () {
        const $ = id => document.getElementById(id);
        const msg = $("jy-msg");

        /* ---- JSON -> YAML ---- */
        function toYaml(v, indent) {
            const pad = "  ".repeat(indent);
            if (v === null) return "null";
            if (Array.isArray(v)) {
                if (!v.length) return "[]";
                return v.map(item => {
                    if (item !== null && typeof item === "object" && (Array.isArray(item) ? item.length : Object.keys(item).length)) {
                        const lines = toYaml(item, indent + 1).split("\n");
                        lines[0] = pad + "- " + lines[0].trimStart();
                        return lines.join("\n");
                    }
                    return pad + "- " + toYaml(item, 0);
                }).join("\n");
            }
            if (typeof v === "object") {
                const keys = Object.keys(v);
                if (!keys.length) return "{}";
                return keys.map(k => {
                    const val = v[k];
                    const key = /^[A-Za-z0-9_.-]+$/.test(k) ? k : JSON.stringify(k);
                    if (val !== null && typeof val === "object" && (Array.isArray(val) ? val.length : Object.keys(val).length))
                        return pad + key + ":\n" + toYaml(val, indent + 1);
                    return pad + key + ": " + toYaml(val, 0);
                }).join("\n");
            }
            if (typeof v === "string") {
                if (v === "" || /^[\s#&*!|>%@`"'{}[\],:-]|[:#]\s|\s$|^(true|false|null|yes|no|on|off|~)$/i.test(v) || /^-?\d/.test(v) || v.includes("\n"))
                    return JSON.stringify(v);
                return v;
            }
            return String(v);
        }

        /* ---- YAML -> JSON (minimal block-style parser) ---- */
        function parseScalar(s) {
            s = s.trim();
            if (s === "" ) return null;
            if (/^["']/.test(s)) {
                if (s[0] === '"') return JSON.parse(s);
                return s.slice(1, -1).replace(/''/g, "'");
            }
            if (s === "null" || s === "~") return null;
            if (s === "true") return true;
            if (s === "false") return false;
            if (/^-?\d+$/.test(s)) return parseInt(s, 10);
            if (/^-?\d*\.\d+(e[+-]?\d+)?$/i.test(s)) return parseFloat(s);
            if (/^[\[{]/.test(s)) return JSON.parse(s.replace(/([{,]\s*)([A-Za-z0-9_.-]+)\s*:/g, '$1"$2":').replace(/'/g, '"'));
            return s;
        }

        function stripComment(line) {
            let inS = false, inD = false;
            for (let i = 0; i < line.length; i++) {
                const c = line[i];
                if (c === "'" && !inD) inS = !inS;
                else if (c === '"' && !inS) inD = !inD;
                else if (c === "#" && !inS && !inD && (i === 0 || /\s/.test(line[i - 1]))) return line.slice(0, i);
            }
            return line;
        }

        function parseYaml(text) {
            const lines = text.split("\n")
                .map(stripComment)
                .filter(l => l.trim() !== "" && l.trim() !== "---");
            let idx = 0;

            function indentOf(l) { return l.match(/^ */)[0].length; }

            function parseBlock(minIndent) {
                if (idx >= lines.length) return null;
                const first = lines[idx];
                const ind = indentOf(first);
                if (ind < minIndent) return null;
                const isList = first.trim().startsWith("- ") || first.trim() === "-";
                if (isList) {
                    const arr = [];
                    while (idx < lines.length && indentOf(lines[idx]) === ind && (lines[idx].trim().startsWith("- ") || lines[idx].trim() === "-")) {
                        const line = lines[idx];
                        const rest = line.trim() === "-" ? "" : line.trim().slice(2);
                        if (rest === "") {
                            idx++;
                            arr.push(parseBlock(ind + 1));
                        } else if (/^[^"']*?:(\s|$)/.test(rest) && !/^[\[{]/.test(rest)) {
                            // inline "- key: value" - rewrite as mapping lines at deeper indent
                            lines[idx] = " ".repeat(ind + 2) + rest;
                            arr.push(parseBlock(ind + 1));
                        } else {
                            idx++;
                            arr.push(parseScalar(rest));
                        }
                    }
                    return arr;
                }
                const obj = {};
                while (idx < lines.length && indentOf(lines[idx]) === ind && !lines[idx].trim().startsWith("- ")) {
                    const line = lines[idx].trim();
                    const m = /^("(?:[^"\\]|\\.)*"|'(?:[^']|'')*'|[^:]+):(.*)$/.exec(line);
                    if (!m) throw new Error("Cannot parse line: " + line);
                    let key = m[1].trim();
                    if (/^["']/.test(key)) key = String(parseScalar(key));
                    const rest = m[2].trim();
                    idx++;
                    if (rest === "") {
                        const next = idx < lines.length ? indentOf(lines[idx]) : -1;
                        obj[key] = next > ind ? parseBlock(ind + 1) : null;
                    } else {
                        obj[key] = parseScalar(rest);
                    }
                }
                return obj;
            }

            if (!lines.length) return null;
            const result = parseBlock(0);
            if (idx < lines.length) throw new Error("Unexpected content at line: " + lines[idx].trim());
            return result;
        }

        function fail(e) { msg.textContent = e.message; msg.classList.remove("hidden"); }

        $("jy-tojaml").addEventListener("click", () => {
            msg.classList.add("hidden");
            try { $("jy-yaml").value = toYaml(JSON.parse($("jy-json").value), 0); }
            catch (e) { fail(e); }
        });
        $("jy-tojson").addEventListener("click", () => {
            msg.classList.add("hidden");
            try { $("jy-json").value = JSON.stringify(parseYaml($("jy-yaml").value), null, 2); }
            catch (e) { fail(e); }
        });
    })();
    </script>
</ToolShell>
