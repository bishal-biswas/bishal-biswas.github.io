---
import ToolShell from "../../components/ToolShell.astro";
---

<ToolShell
    slug="curl-to-fetch"
    title="cURL to JavaScript Fetch Converter Online Free"
    metaDescription="Convert cURL commands to JavaScript fetch() code online for free. Paste any curl command and get modern async/await fetch code with headers, method and body."
    pageHeadingText="cURL to Fetch"
>
    <div slot="tool" class="tool-grid2">
        <div class="flex flex-col gap-3">
            <label class="tool-label" for="cf-in">cURL command</label>
            <textarea id="cf-in" class="tool-input" placeholder={`curl -X POST https://api.example.com/users \\\n  -H 'Content-Type: application/json' \\\n  -H 'Authorization: Bearer TOKEN' \\\n  -d '{"name":"Ada"}'`} spellcheck="false"></textarea>
            <div class="tool-row">
                <button id="cf-convert" class="tool-btn"><i class="fa-solid fa-arrow-right"></i> Convert</button>
            </div>
            <p id="cf-msg" class="tool-error hidden"></p>
        </div>
        <div class="flex flex-col gap-3">
            <label class="tool-label" for="cf-out">JavaScript fetch()</label>
            <textarea id="cf-out" class="tool-input" readonly spellcheck="false"></textarea>
            <div class="tool-row">
                <button id="cf-copy" class="tool-btn-ghost"><i class="fa-regular fa-copy"></i> Copy</button>
            </div>
        </div>
    </div>

    <h2>Convert cURL commands to JavaScript fetch</h2>
    <p>
        API docs, browser DevTools ("Copy as cURL") and tools like Postman all hand you <strong>cURL commands</strong> -
        but your frontend or Node.js code needs <strong>fetch()</strong>. This converter parses the curl command and
        generates clean, modern <code>async/await</code> fetch code with the method, headers, body, credentials and
        basic auth carried over.
    </p>

    <h2>Supported cURL options</h2>
    <ul>
        <li><code>-X / --request</code> - HTTP method (GET, POST, PUT, PATCH, DELETE…).</li>
        <li><code>-H / --header</code> - any number of request headers.</li>
        <li><code>-d / --data / --data-raw / --data-binary</code> - request body (JSON bodies are pretty-printed).</li>
        <li><code>-F / --form</code> - multipart form data via <code>FormData</code>.</li>
        <li><code>-u / --user</code> - Basic authentication, converted to an <code>Authorization</code> header.</li>
        <li><code>-b / --cookie</code> - cookies, sent via the <code>Cookie</code> header.</li>
    </ul>

    <h2>From DevTools to working code in seconds</h2>
    <ol>
        <li>In Chrome or Firefox DevTools, open the <strong>Network</strong> tab, right-click a request and choose <em>Copy → Copy as cURL</em>.</li>
        <li>Paste the command above and click <strong>Convert</strong>.</li>
        <li>Copy the generated fetch code into your project and refactor the token/URL into config.</li>
    </ol>
    <p>
        The conversion runs entirely in your browser - commands containing API keys and session cookies never leave
        your machine (still, rotate any secrets you paste anywhere). Decoding the Bearer token you just pasted?
        Use the <a href="/tools/jwt-decoder">JWT decoder</a>.
    </p>

    <script is:inline>
    (function () {
        const $ = id => document.getElementById(id);

        function shellSplit(cmd) {
            // handles quotes and line continuations
            cmd = cmd.replace(/\\\r?\n/g, " ").replace(/\^\r?\n/g, " ").trim();
            const args = [];
            const re = /"((?:[^"\\]|\\.)*)"|'([^']*)'|(\$'(?:[^'\\]|\\.)*')|([^\s"']+)/g;
            let m;
            while ((m = re.exec(cmd))) {
                if (m[1] !== undefined) args.push(m[1].replace(/\\(["\\$`])/g, "$1"));
                else if (m[2] !== undefined) args.push(m[2]);
                else if (m[3] !== undefined) args.push(m[3].slice(2, -1).replace(/\\n/g, "\n").replace(/\\'/g, "'"));
                else args.push(m[4]);
            }
            return args;
        }

        function convert(cmd) {
            const args = shellSplit(cmd);
            if (!args.length || !/^curl(\.exe)?$/i.test(args[0])) throw new Error("Command should start with `curl`.");

            let url = "", method = "", body = null, isForm = false;
            const headers = {}, forms = [];
            for (let i = 1; i < args.length; i++) {
                const a = args[i];
                const next = () => args[++i] ?? "";
                if (a === "-X" || a === "--request") method = next().toUpperCase();
                else if (a === "-H" || a === "--header") {
                    const h = next(); const idx = h.indexOf(":");
                    if (idx > 0) headers[h.slice(0, idx).trim()] = h.slice(idx + 1).trim();
                }
                else if (["-d", "--data", "--data-raw", "--data-binary", "--data-ascii", "--data-urlencode"].includes(a)) body = next();
                else if (a === "-F" || a === "--form") { isForm = true; forms.push(next()); }
                else if (a === "-u" || a === "--user") headers["Authorization"] = "Basic " + btoa(next());
                else if (a === "-b" || a === "--cookie") headers["Cookie"] = next();
                else if (a === "-A" || a === "--user-agent") headers["User-Agent"] = next();
                else if (a === "-e" || a === "--referer") headers["Referer"] = next();
                else if (a === "--url") url = next();
                else if (["-I", "--head"].includes(a)) method = "HEAD";
                else if (["-s","-S","-v","-k","-L","-i","--compressed","--insecure","--location","--silent","--verbose","-g","--globoff"].includes(a)) { /* no-op flags */ }
                else if (["-o", "--output", "--connect-timeout", "--max-time", "--retry", "-m"].includes(a)) next();
                else if (!a.startsWith("-") && !url) url = a;
            }
            if (!url) throw new Error("No URL found in the command.");
            if (!method) method = (body !== null || isForm) ? "POST" : "GET";

            const lines = [];
            lines.push(`const response = await fetch(${JSON.stringify(url)}, {`);
            lines.push(`    method: ${JSON.stringify(method)},`);
            if (Object.keys(headers).length) {
                lines.push(`    headers: {`);
                for (const [k, v] of Object.entries(headers)) lines.push(`        ${JSON.stringify(k)}: ${JSON.stringify(v)},`);
                lines.push(`    },`);
            }
            if (isForm) {
                const fd = ["const formData = new FormData();"];
                for (const f of forms) {
                    const idx = f.indexOf("=");
                    const k = f.slice(0, idx), v = f.slice(idx + 1);
                    fd.push(v.startsWith("@")
                        ? `formData.append(${JSON.stringify(k)}, fileInput.files[0]); // was: ${v}`
                        : `formData.append(${JSON.stringify(k)}, ${JSON.stringify(v)});`);
                }
                lines.push(`    body: formData,`);
                lines.unshift(fd.join("\n") + "\n");
            } else if (body !== null) {
                let rendered = JSON.stringify(body);
                try { rendered = "JSON.stringify(" + JSON.stringify(JSON.parse(body), null, 4).replace(/\n/g, "\n    ") + ")"; } catch {}
                lines.push(`    body: ${rendered},`);
            }
            lines.push(`});`);
            lines.push(``);
            lines.push(`const data = await response.json();`);
            lines.push(`console.log(data);`);
            return lines.join("\n");
        }

        $("cf-convert").addEventListener("click", () => {
            const msg = $("cf-msg");
            msg.classList.add("hidden");
            try { $("cf-out").value = convert($("cf-in").value); }
            catch (e) { $("cf-out").value = ""; msg.textContent = e.message; msg.classList.remove("hidden"); }
        });
        $("cf-copy").addEventListener("click", () => navigator.clipboard.writeText($("cf-out").value));
    })();
    </script>
</ToolShell>
