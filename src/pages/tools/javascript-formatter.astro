---
import ToolShell from "../../components/ToolShell.astro";
---

<ToolShell
    slug="javascript-formatter"
    title="JavaScript Formatter - Pretty Print JS Online Free"
    metaDescription="Format JavaScript online for free. Beautify minified JS with clean indentation, line breaks and readable structure in the browser."
    pageHeadingText="JavaScript Formatter"
>
    <div slot="tool" class="flex flex-col gap-4">
        <div>
            <label class="tool-label" for="jsf-in">Paste JavaScript</label>
            <textarea id="jsf-in" class="tool-input" placeholder="function greet(name){return 'Hello '+name}const user={name:'Ada',role:'admin'}" spellcheck="false"></textarea>
        </div>
        <div class="tool-row">
            <button id="jsf-format" class="tool-btn"><i class="fa-solid fa-wand-magic-sparkles"></i> Format</button>
            <button id="jsf-copy" class="tool-btn-ghost"><i class="fa-regular fa-copy"></i> Copy</button>
            <button id="jsf-clear" class="tool-btn-ghost">Clear</button>
        </div>
        <p id="jsf-msg" class="tool-error hidden"></p>
        <div>
            <label class="tool-label" for="jsf-out">Formatted JavaScript</label>
            <textarea id="jsf-out" class="tool-input" readonly spellcheck="false"></textarea>
        </div>
    </div>

    <h2>Beautify JavaScript for easier reading</h2>
    <p>
        This <strong>JavaScript formatter</strong> takes compressed or messy script code and breaks it into clear, readable lines.
        It is helpful when you are reviewing minified libraries, debugging generated scripts, or making client-side code easier to
        scan before editing.
    </p>

    <h2>When to use it</h2>
    <ul>
        <li>Reviewing code from a bundled script or CDN.</li>
        <li>Making generated JavaScript easier to debug.</li>
        <li>Preparing code for a code review or handoff.</li>
        <li>Cleaning up copied snippets from documentation or examples.</li>
    </ul>

    <p>
        Need the compact version instead? Use the <a href="/tools/javascript-obfuscator">JavaScript obfuscator</a> to make code harder to read.
        For styling, the <a href="/tools/css-formatter">CSS formatter</a> uses the same idea for stylesheet readability.
    </p>

    <script is:inline>
    (function () {
        const $ = id => document.getElementById(id);
        const input = $("jsf-in");
        const output = $("jsf-out");
        const msg = $("jsf-msg");

        function formatJs(code) {
            const safe = code.trim();
            if (!safe) return "";

            let formatted = safe
                .replace(/\s*\{\s*/g, " {\n")
                .replace(/\s*\}\s*/g, "\n}\n")
                .replace(/\s*;\s*/g, ";\n")
                .replace(/\s*\(\s*/g, "(")
                .replace(/\s*\)\s*/g, ")")
                .replace(/\s*,\s*/g, ", ")
                .replace(/\s*:\s*/g, ": ")
                .replace(/\s*=>\s*/g, " => ");

            const lines = formatted.split(/\n/);
            let indent = 0;
            const result = [];

            lines.forEach(line => {
                const trimmed = line.trim();
                if (!trimmed) return;

                if (trimmed === "}") {
                    indent = Math.max(0, indent - 1);
                }

                result.push("  ".repeat(indent) + trimmed);

                if (trimmed.endsWith("{") || trimmed.endsWith("=> {")) {
                    indent += 1;
                }
            });

            return result.join("\n");
        }

        $("jsf-format").addEventListener("click", () => {
            msg.classList.add("hidden");
            try {
                output.value = formatJs(input.value);
            } catch (error) {
                output.value = "";
                msg.textContent = "Unable to format JavaScript: " + error.message;
                msg.classList.remove("hidden");
            }
        });

        $("jsf-copy").addEventListener("click", () => navigator.clipboard.writeText(output.value));
        $("jsf-clear").addEventListener("click", () => {
            input.value = "";
            output.value = "";
            msg.classList.add("hidden");
        });
    })();
    </script>
</ToolShell>
