---
import ToolShell from "../../components/ToolShell.astro";
---

<ToolShell
    slug="color-converter"
    title="HEX to RGB to HSL Color Converter Online Free"
    metaDescription="Convert colors between HEX, RGB and HSL online for free with a live preview and color picker. Instant CSS color code conversion in your browser."
    pageHeadingText="HEX / RGB / HSL Converter"
>
    <div slot="tool" class="flex flex-col gap-4">
        <div class="tool-row" style="align-items:stretch">
            <div id="cc-preview" style="width:6rem;border-radius:1rem;border:1px solid #58769149;background:#58ded6"></div>
            <div class="flex flex-col gap-3" style="flex:1">
                <div>
                    <label class="tool-label" for="cc-hex">HEX</label>
                    <div class="tool-row">
                        <input id="cc-hex" class="tool-input" style="font-family:monospace" value="#58ded6" spellcheck="false" />
                        <input id="cc-picker" type="color" value="#58ded6" style="width:3rem;height:2.7rem;border:none;background:none;cursor:pointer" />
                    </div>
                </div>
                <div>
                    <label class="tool-label" for="cc-rgb">RGB</label>
                    <input id="cc-rgb" class="tool-input" style="font-family:monospace" value="rgb(88, 222, 214)" spellcheck="false" />
                </div>
                <div>
                    <label class="tool-label" for="cc-hsl">HSL</label>
                    <input id="cc-hsl" class="tool-input" style="font-family:monospace" value="hsl(176, 67%, 61%)" spellcheck="false" />
                </div>
            </div>
        </div>
        <p id="cc-msg" class="tool-error hidden"></p>
        <p class="tool-note">Edit any field - the other two and the preview update instantly.</p>
    </div>

    <h2>Convert colors between HEX, RGB and HSL</h2>
    <p>
        This <strong>color converter</strong> translates any CSS color between its three most common notations -
        <strong>HEX</strong> (<code>#58ded6</code>), <strong>RGB</strong> (<code>rgb(88, 222, 214)</code>) and
        <strong>HSL</strong> (<code>hsl(176, 67%, 61%)</code>) - with a live swatch so you always see what you're
        working with. Type in any field, use the native color picker, and copy the format your stylesheet needs.
    </p>

    <h2>HEX vs RGB vs HSL - which should you use?</h2>
    <ul>
        <li><strong>HEX</strong> - the most compact and universally recognized; ideal for design handoffs and brand palettes. Supports shorthand (<code>#fff</code>) and alpha (<code>#ffffff80</code>).</li>
        <li><strong>RGB</strong> - maps directly to how screens emit light; <code>rgba()</code> makes per-color transparency easy.</li>
        <li><strong>HSL</strong> - the most human-friendly: hue picks the color, saturation its intensity, lightness its brightness. Perfect for generating hover states (<em>same hue, lower lightness</em>) and full palettes programmatically.</li>
    </ul>

    <h2>How the conversion works</h2>
    <p>
        HEX is just RGB in hexadecimal - <code>58</code> = 88, <code>de</code> = 222, <code>d6</code> = 214. HSL is a
        cylindrical remapping of the same values: hue is the angle on the color wheel (0–360°), saturation the
        distance from gray, lightness the distance from black to white. All conversions are exact and computed
        locally in JavaScript.
    </p>
    <p>
        Building a theme? Pair this with the <a href="/tools/html-preview">HTML preview</a> to test your palette in
        real markup.
    </p>

    <script is:inline>
    (function () {
        const $ = id => document.getElementById(id);
        const msg = $("cc-msg");

        function hexToRgb(hex) {
            hex = hex.trim().replace(/^#/, "");
            if (/^[0-9a-f]{3}$/i.test(hex)) hex = hex.split("").map(c => c + c).join("");
            if (!/^[0-9a-f]{6}$/i.test(hex)) return null;
            return [parseInt(hex.slice(0, 2), 16), parseInt(hex.slice(2, 4), 16), parseInt(hex.slice(4, 6), 16)];
        }
        function rgbToHex([r, g, b]) {
            return "#" + [r, g, b].map(v => v.toString(16).padStart(2, "0")).join("");
        }
        function rgbToHsl([r, g, b]) {
            r /= 255; g /= 255; b /= 255;
            const max = Math.max(r, g, b), min = Math.min(r, g, b), l = (max + min) / 2;
            if (max === min) return [0, 0, Math.round(l * 100)];
            const d = max - min;
            const s = l > 0.5 ? d / (2 - max - min) : d / (max + min);
            let h;
            if (max === r) h = ((g - b) / d + (g < b ? 6 : 0));
            else if (max === g) h = (b - r) / d + 2;
            else h = (r - g) / d + 4;
            return [Math.round(h * 60), Math.round(s * 100), Math.round(l * 100)];
        }
        function hslToRgb([h, s, l]) {
            h = ((h % 360) + 360) % 360; s /= 100; l /= 100;
            const c = (1 - Math.abs(2 * l - 1)) * s;
            const x = c * (1 - Math.abs(((h / 60) % 2) - 1));
            const m = l - c / 2;
            let rgb = h < 60 ? [c, x, 0] : h < 120 ? [x, c, 0] : h < 180 ? [0, c, x] : h < 240 ? [0, x, c] : h < 300 ? [x, 0, c] : [c, 0, x];
            return rgb.map(v => Math.round((v + m) * 255));
        }

        function parseRgbStr(s) {
            const m = /^rgba?\(\s*(\d{1,3})\s*[, ]\s*(\d{1,3})\s*[, ]\s*(\d{1,3})/i.exec(s.trim());
            if (!m) return null;
            const rgb = [+m[1], +m[2], +m[3]];
            return rgb.every(v => v <= 255) ? rgb : null;
        }
        function parseHslStr(s) {
            const m = /^hsla?\(\s*(-?\d+(?:\.\d+)?)(?:deg)?\s*[, ]\s*(\d{1,3})%?\s*[, ]\s*(\d{1,3})%?/i.exec(s.trim());
            if (!m) return null;
            return hslToRgb([+m[1], +m[2], +m[3]]);
        }

        function render(rgb, skip) {
            const [h, s, l] = rgbToHsl(rgb);
            if (skip !== "hex") $("cc-hex").value = rgbToHex(rgb);
            if (skip !== "rgb") $("cc-rgb").value = `rgb(${rgb[0]}, ${rgb[1]}, ${rgb[2]})`;
            if (skip !== "hsl") $("cc-hsl").value = `hsl(${h}, ${s}%, ${l}%)`;
            $("cc-picker").value = rgbToHex(rgb);
            $("cc-preview").style.background = rgbToHex(rgb);
            msg.classList.add("hidden");
        }
        function fail(what) { msg.textContent = "Could not parse " + what + " value."; msg.classList.remove("hidden"); }

        $("cc-hex").addEventListener("input", () => { const rgb = hexToRgb($("cc-hex").value); rgb ? render(rgb, "hex") : fail("HEX"); });
        $("cc-rgb").addEventListener("input", () => { const rgb = parseRgbStr($("cc-rgb").value); rgb ? render(rgb, "rgb") : fail("RGB"); });
        $("cc-hsl").addEventListener("input", () => { const rgb = parseHslStr($("cc-hsl").value); rgb ? render(rgb, "hsl") : fail("HSL"); });
        $("cc-picker").addEventListener("input", () => render(hexToRgb($("cc-picker").value), null));
    })();
    </script>
</ToolShell>
