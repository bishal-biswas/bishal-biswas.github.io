---
import { Breadcrumbs } from "astro-breadcrumbs";
import "astro-breadcrumbs/breadcrumbs.css";

import "../../astro-breadcrumbs-config.scss"
---

<span class="my-7 block rounded-full border-white border-2 w-fit px-4 p-3 capitalize">
    <Breadcrumbs>
        <svg
        slot="index"
        aria-label="Home Page"
        xmlns="http://www.w3.org/2000/svg"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        ><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"> </path><polyline
          points="9 22 9 12 15 12 15 22"></polyline>
      </svg>
    
      <i slot="separator" class="fa-sharp fa-solid fa-slash rotate-60"></i>
      
    </Breadcrumbs>
</span>