---
import { articleLayouts, type ArticleLayoutKey } from "../data/articles";

interface Props {
    current: ArticleLayoutKey
}

const { current } = Astro.props;
---

<!-- Each layout is its own paginated route, so switching always lands on page 1. -->
<nav aria-label="Article layout" class="layout-switcher flex flex-wrap items-center gap-2">
    <span class="text-xs uppercase tracking-widest text-font-gray mr-1">View</span>
    {
        articleLayouts.map((layout) => (
            <a
                href={layout.base + "/"}
                aria-current={layout.key === current ? "page" : undefined}
                class="flex items-center gap-2 rounded-full px-4 py-2 text-xs font-semibold uppercase tracking-wide shadow-sm shadow-[#000000be] hover:scale-105 transition-all ease-in-out duration-300"
                class:list={[
                    layout.key === current
                        ? "bg-lite-green text-white"
                        : "bg-dark-teal text-[#00283a] dark:text-font-white hover:bg-lite-green hover:text-white",
                ]}
            >
                <i class={layout.icon} aria-hidden="true"></i>
                {layout.label}
            </a>
        ))
    }
</nav>
