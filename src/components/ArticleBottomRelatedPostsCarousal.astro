---
import { getCollection } from "astro:content";
import HeadingText from "./headingText.astro";
import { filterFuturePosts, getPaths } from "../data/utils";

interface Props {
    category: string,
    ignoreArticle: string
}

const {category, ignoreArticle} = Astro.props;
let allBlogPosts = await getCollection("article");
allBlogPosts = filterFuturePosts(allBlogPosts);
let RelatedArticles = [];

for (let i = 0; i < allBlogPosts.length; i++) {
    if(allBlogPosts[i].data.category == category && ignoreArticle != allBlogPosts[i].data.title)
    RelatedArticles.push(allBlogPosts[i]);
}

---

<style>
    .article-navigation swiper-slide img {
        height: 170px;
    }
</style>
{
    RelatedArticles.length ? 
    <div class="related-articles w-full">
        <HeadingText
            verticalMarginClass="my-6"
            TagType="span"
            headText={"Some other articles related to " + category} />

        <div class="article-navigation gap-3 w-full p-5 rounded-lg dark:bg-dark-teal bg-dark-teal shadow-sm shadow-[#000000be]">
            <swiper-container class="mySwiper" init="false">
                {
                    allBlogPosts.map(
                        (post: any) =>
                            (post.data.category == category && ignoreArticle != post.data.title) && (
                                <swiper-slide>
                                    <div class="article-card rounded-lg shadow-2xl size-full my-7">
                                        <a href={post.data.slug} class="article-thumbnail h-[70%] block" >
                                            <img src={getPaths("Article")+post.data.featuredImage} alt="article-thumbnail" class="rounded-tr-lg w-full rounded-tl-lg h-[145px]" />
                                        </a>
                                        <div class="article-data h-[60px] p-2 text-left dark:bg-body-bg rounded-br-lg rounded-bl-lg">
                                            <a href={post.data.slug} class="line-clamp-2 text-sm" >
                                                {post.data.title}
                                            </a>
                                        </div>
                                    </div>
                                </swiper-slide>
                            ),
                    )
                }
            </swiper-container>
        </div>
    </div>
    <script is:inline>
        const swiperEl = document.querySelector(".article-navigation swiper-container");
        Object.assign(swiperEl, {
            slidesPerView: 3.7,
            spaceBetween: 30,
            breakpoints: {
                "@0.00": {
                    slidesPerView: 1.1,
                    spaceBetween: 10,
                },
                "@0.75": {
                    slidesPerView: 2.1,
                    spaceBetween: 20,
                },
                "@1.00": {
                    slidesPerView: 2.6,
                    spaceBetween: 40,
                },
                "@1.50": {
                    slidesPerView: 3.7,
                    spaceBetween: 30,
                },
            },
        });

        swiperEl.initialize();
        
    </script>
    : <p class="text-center">Oops 😥 I haven't written more articles related to <b>{category}</b>.</p>
}


