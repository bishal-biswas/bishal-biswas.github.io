<script is:inline>
    function showNotification(message) {
        const notification = document.getElementById("notification");
        const messageElement = document.getElementById("notification-message");

        // Update the notification message
        messageElement.textContent = message;

        // Show the notification with animation
        notification.classList.remove("translate-x-full", "opacity-0", "scale-95");
        notification.classList.add("opacity-100", "scale-100");

        // Hide the notification after 3 seconds
        setTimeout(() => {
            notification.classList.remove("opacity-100", "scale-100");
            notification.classList.add("translate-x-full", "opacity-0", "scale-95");

            // Fully hide the notification after animation ends
            setTimeout(() => {
                notification.classList.add("translate-x-full");
            }, 300); // Match this duration with Tailwind transition duration
        }, 3000);
    }
    showNotification("This Website is in Devlopment Phase.")
</script>
