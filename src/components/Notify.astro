<div id="notification" class="fixed bottom-4 right-4 translate-x-full z-[11] dark:bg-dark-teal dark:text-teal-white dark:text-font-white bg-white px-4 py-2 border-2 border-lite-green rounded shadow shadow-lite-green transition-transform transform opacity-0 scale-95">
    <p id="notification-message">This is a notification message!</p>
</div>

<!-- <button
    onclick="showNotification('Hello! This is your notification.')"
