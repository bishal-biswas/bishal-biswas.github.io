---
// import ViewTransitions from 'astro/components/ViewTransitions.astro';
import { SEO } from "astro-seo";
import { personaInfo } from "../data/site-data/profile";
import { getPaths } from "../data/utils";

interface Props {
    metaDescription: string,
    title: string,
    // Open Graph object type for this page: "website" | "article" | "profile"
    ogType?: string,
    // Page specific share image. Relative paths are resolved against `site`.
    ogImage?: string
}

const defaultOgImage = getPaths("Other Files") + "thumbnail.webp";
const defaultDescription = personaInfo.Bio.bioText;

const {metaDescription = defaultDescription, title, ogType = "website", ogImage = defaultOgImage} = Astro.props;

// Social crawlers require absolute URLs, so resolve anything relative against the configured site.
const canonicalURL = new URL(Astro.url.pathname, Astro.site).href;
const socialImageURL = new URL(ogImage, Astro.site).href;
---

<head>
    <meta charset="UTF-8">
    <link rel="icon" type="image/webp" href="/favicon.webp" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="generator" content={Astro.generator} />

    <SEO
        title={title}
        description={metaDescription}
        canonical={canonicalURL}
        openGraph={{
            basic: {
                title: `${title}`,
                type: ogType,
                image: socialImageURL,
                url: canonicalURL,
            },
            optional: {
                description: metaDescription,
                siteName: personaInfo.fullName,
            },
            image: {
                alt: `${title}`,
            }
        }}
        twitter={{
          card: "summary_large_image",
          site: "@bishalbiswas",
          creator: "@bishalbiswas",
          title: `${title}`,
          description: metaDescription,
          image: socialImageURL,
          imageAlt: `${title}`,
        }}
        extend={{
          // extending the default link tags
          link: [{ rel: "icon", href: "/favicon.webp" }],
        }}
    />

    <link rel="stylesheet" href="/assets/styles/main.css">
    <link rel="stylesheet" href="/assets/styles/styles.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.3.1/css/all.min.css"/>
    <link rel="sitemap" href="/sitemap-index.xml" />
    <!-- <ViewTransitions /> -->

    <slot />
    <script is:inline>
        if(localStorage.getItem("theme") == null){
            if(window.matchMedia('(prefers-color-scheme: dark)').matches){
                localStorage.theme = 'dark'
                document.querySelector("html").classList.add("dark");
            }
            else{
                localStorage.theme = 'light'
                document.querySelector("html").classList.remove("dark");
            }           

            if(localStorage.getItem("theme") == "dark"){
                document.addEventListener("DOMContentLoaded", ()=>{
                    document.getElementById('themeToggleCheckbox').checked = true;          
                })
            }

        }
        else{
            if(localStorage.theme === "dark") document.querySelector("html").classList.add("dark");
            else document.querySelector("html").classList.remove("dark");
        }
    </script>
</head>
