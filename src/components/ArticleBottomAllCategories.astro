---
import HeadingText from "./headingText.astro";

import { getCollection } from "astro:content";
import { getCategoryImage, findCategoryCount, getPaths, filterFuturePosts } from "../data/utils.ts"

let allBlogPosts = await getCollection("blog");
allBlogPosts = filterFuturePosts(allBlogPosts);
var categAllArticles: string[] = []; 
for (let i = 0; i < allBlogPosts.length; i++) categAllArticles.push(allBlogPosts[i].data.category);

/* var allCategories = null 
allCategories = getAllCategories(categAllArticles); */

const uniqueArr = [...new Set(categAllArticles)];

---

<div class="all-categories w-full animate-on-scroll">
    <HeadingText headText="Categories" TagType="span" verticalMarginClass="my-6"/>

    <div class="article-categories-container flex justify-between items-center w-full p-5 py-7 rounded-lg dark:bg-dark-teal bg-dark-teal shadow-sm shadow-[#000000be]">
        <div class="Category relative flex lg:justify-around items-center gap-2 lg:gap-4 flex-wrap font-semibold lg:text-sm text-xs" >
            {
                uniqueArr.length != 0 && 
                uniqueArr.map((category)=>(
                <a
                        href={"/articles/category/"+category.toLocaleLowerCase().replaceAll(" ", "-")}
                        class="font-semibold flex justify-center items-center gap-2 w-fit rounded-lg border-2 dark:border-font-white border-font-gray dark:text-teal-white dark:text-font-white text-teal-white dark:text-font-white uppercase overflow-hidden hover:scale-105 transition-all ease-in-out duration-300" >
                        <img
                            src={getPaths("Categories") + getCategoryImage(category)}
                            alt="CategoryImage"
                            class="bg-white size-7 lg:size-12 object-cover"
                        /> 
                        
                        <span class="pr-1 flex items-center gap-2">
                            <span>{category}</span>
                            <span class="p-3 flex justify-center items-center size-3 rounded-full dark:bg-body-bg-2 bg-body-bg-2">{findCategoryCount(category, categAllArticles)}</span>
                        </span>
                    </a>
                ))
            }
        </div>
    </div>
</div>
