---
import type { CollectionEntry } from "astro:content";
import { getFormattedDate, getPaths } from "../data/utils";

interface Props {
    post: CollectionEntry<"article">,
    index ?: number
}

const {post, index = 1} = Astro.props;
---

<article class="article-card group overflow-hidden relative w-full rounded-lg dark:bg-dark-teal bg-dark-teal hover:shadow-2xl shadow-sm shadow-[#000000be] animate-on-scroll"
    class:list={[
        {
            "md:w-[48%] md:h-[250px] h-[250px] lg:h-[300px]": index == 3 || index == 4,
        },
        {
            "md:w-[48%] lg:w-[32%] h-[250px]": index < 3 || index > 4 ,
        },
    ]}
>
    <div class="thumbnail h-full w-full absolute z-0 top-0">
        <a href={"/articles/" + post.data.slug} class="w-full h-full">
            <img
                src={getPaths("Article") + post.data.featuredImage}
                alt="article Thumbnail Image"
                style={`view-transition-name: article-image-${post.data.slug}`}
                class="FeatureImg group-hover:scale-100 w-full h-full object-cover object-center rounded-lg scale-110 transition-all ease-in-out"
            />
        </a>
    </div>
    <div
        class="article-snippet group-hover:translate-y-0 absolute z-[1] bottom-0 translate-y-full w-full p-3 uppercase text-xs text-[#dedee0] bg-[#00283aeb] rounded-br-lg rounded-bl-lg transition-transform ease-in-out duration-300"
    >
        <div class="tags flex flex-wrap gap-2 line-clamp-2">
            {
                post.data.tags.map((tag: string) => (
                    <span class="hover:text-[#70ba65] cursor-pointer">
                        <a href={"/articles/tag/" + tag.toLowerCase().replaceAll(" ","-")}>#{tag}</a>
                    </span>
                ))
            }
        </div>
        <h2 class="line-clamp-2 my-2 text-lg w-fit font-bold hover:text-[#70ba65]">
            <a href={"/articles/" + post.data.slug}>{post.data.title}</a>
        </h2>
        <span
            class="divider block w-full my-4 border-t border-dotted border-gray-500"
        ></span>
        <span
            class="articleDate flex gap-3 items-center rounded-tr-lg rounded-tl-lg"
        >
            <i class="fa-solid fa-calendar-days"></i>
            <span class="date">
                {getFormattedDate(post.data.publishDate)}
            </span>
        </span>
    </div>
</article>
