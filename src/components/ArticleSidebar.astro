---
import { getPaths } from "../data/utils"
import SocialLinks from "./SocialLinks.astro"

const socialLinkType = Math.floor(Math.random() * (1 - 0 + 1)) + 0;
---

<aside class="sideBar flex flex-col items-center lg:w-[27%]">
    <div class="widget w-full">
        <span class="heading-wrapper w-full my-5 flex items-center relative border-t border-[#919ca1] border-dotted">
            <span class="absolute text-xl font-bold pr-4 z-[1] dark:bg-body-bg-2 bg-body-bg-2">Subscribe to Newsletter</span>
        </span>
        <div class="widget-container newsletter flex lg:flex-row flex-col justify-center items-center gap-3 w-full p-3 rounded-lg dark:bg-dark-teal bg-dark-teal shadow-sm shadow-[#000000be]">
            <form class="flex flex-col gap-5 w-full">
                <input required type="email" class="dark:bg-body-bg-2 bg-body-bg-2 px-4 py-2 rounded-xl w-full" placeholder="Enter your Email Address">
                <span class="flex justify-center">
                    <button type="submit" class="CTAbtn w-full rounded-full p-7 py-3 bg-lite-green text-white text-xs font-semibold uppercase hover:scale-105 transition-all ease-in-out duration-300">
                        Subscribe <i class="ml-2 fa-duotone fa-arrow-right transition-all ease-in-out duration-150"></i>
                    </button>
                </span>
            </form>
        </div>
    </div>

    <div class="widget w-full">
        <span class="heading-wrapper w-full my-5 flex items-center relative border-t border-[#919ca1] border-dotted">
            <span class="absolute text-xl font-bold pr-4 z-[1] dark:bg-body-bg-2 bg-body-bg-2">Advertisement</span>
        </span>
        <div class="widget-container ADS flex lg:flex-row flex-col justify-center items-center gap-3 w-full p-3 rounded-lg dark:bg-dark-teal bg-dark-teal shadow-sm shadow-[#000000be]">
            <div class="ad300_250 text-black h-[250px] w-[300px] bg-white flex justify-center items-center">
                <span>Ads placeholder 300 x 250 </span>
            </div>
        </div>
    </div>

    {
        /* Hiding Popular Articles list */
        false &&
        <div class="widget w-full">
            <span class="heading-wrapper w-full my-5 flex items-center relative border-t border-[#919ca1] border-dotted">
                <span class="absolute text-xl font-bold pr-4 z-[1] dark:bg-body-bg-2 bg-body-bg-2">Popular Articles</span>
            </span>
            <div class="widget-container popularPosts flex lg:flex-row flex-col justify-center items-center gap-3 w-full p-3 rounded-lg dark:bg-dark-teal bg-dark-teal shadow-sm shadow-[#000000be]">
                <ul class="flex flex-col gap-5">
                    <li>
                        <a href="" class="flex gap-2">
                            <img src={getPaths("Article")+"article (1).png"} alt="article thumbnail" class="size-16 object-cover rounded-full" />
                            <span class="text-sm font-semibold hover:text-[#70ba65] line-clamp-2">Lorem ipsum, dolor sit amet consectetur adipisicing.</span>
                        </a>
                    </li>
                    <li>
                        <a href="" class="flex gap-2">
                            <img src={getPaths("Article")+"article (1).png"} alt="article thumbnail" class="size-16 object-cover rounded-full" />
                            <span class="text-sm font-semibold hover:text-[#70ba65] line-clamp-2">Lorem ipsum, dolor sit amet consectetur adipisicing.</span>
                        </a>
                    </li>
                    <li>
                        <a href="" class="flex gap-2">
                            <img src={getPaths("Article")+"article (1).png"} alt="article thumbnail" class="size-16 object-cover rounded-full" />
                            <span class="text-sm font-semibold hover:text-[#70ba65] line-clamp-2">Lorem ipsum, dolor sit amet consectetur adipisicing.</span>
                        </a>
                    </li>
                    <li>
                        <a href="" class="flex gap-2">
                            <img src={getPaths("Article")+"article (1).png"} alt="article thumbnail" class="size-16 object-cover rounded-full" />
                            <span class="text-sm font-semibold hover:text-[#70ba65] line-clamp-2">Lorem ipsum, dolor sit amet consectetur adipisicing.</span>
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    }
    
    {
        socialLinkType == 0 ?
        <div class="widget w-full">
            <span class="heading-wrapper w-full my-5 flex items-center relative border-t border-[#919ca1] border-dotted">
                <span class="absolute text-xl font-bold pr-4 z-[1] dark:bg-body-bg-2 bg-body-bg-2">Follow on Social Media</span>
            </span>
            <SocialLinks />
            
        </div>
        :
        <div class="widget w-full">
            <span class="heading-wrapper w-full my-5 flex items-center relative border-t border-[#919ca1] border-dotted">
                <span class="absolute text-xl font-bold pr-4 z-[1] dark:bg-body-bg-2 bg-body-bg-2">Follow on Social Media</span>
            </span>
            <SocialLinks isVertical={false} />
    
        </div>
    }


    <div class="widget w-full sticky top-24">
        <span class="heading-wrapper w-full my-5 flex items-center relative border-t border-[#919ca1] border-dotted">
            <span class="absolute text-xl font-bold pr-4 z-[1] dark:bg-body-bg-2 bg-body-bg-2">Sticky Ad</span>
        </span>
        <div class="widget-container sticky-widget flex lg:flex-row flex-col justify-center items-center gap-3 w-full p-3 rounded-lg dark:bg-dark-teal bg-dark-teal shadow-sm shadow-[#000000be]">
            <div class="ad300_250 text-black h-[250px] w-[300px] bg-white flex justify-center items-center">
                <span>Ads placeholder 300 x 250 </span>
            </div>
        </div>
    </div>

</aside>