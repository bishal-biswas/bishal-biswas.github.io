---
interface Props {
    pageTitle:string, 
    pageFeaturedImage:string
}
const { pageTitle, pageFeaturedImage } = Astro.props;
---

<div class="shareBtns flex items-center gap-3">
    <i class="fa-thin fa-share-nodes"></i>
    <ul class="flex flex-wrap items-center justify-center gap-3">
        <li class="relative">
            <div class="title absolute invisible">Share on facebook</div>
            <a
                href={"https://www.facebook.com/sharer.php?u=" + Astro.url}
                class="size-7 rounded-full bg-lite-green hover:bg-dark-green flex justify-center items-center hover:scale-105 transition-all ease-in-out duration-300"
            >
                <i class="fa-brands fa-facebook-f"></i>
            </a>
        </li>
        <li class="relative">
            <div class="title absolute invisible">Share on x</div>
            <a
                href={"https://twitter.com/share?url=" +
                    Astro.url +
                    "&text=" +
                    pageTitle}
                class="size-7 rounded-full bg-lite-green hover:bg-dark-green flex justify-center items-center hover:scale-105 transition-all ease-in-out duration-300"
            >
                <i class="fa-brands fa-x-twitter"></i>
            </a>
        </li>
        <li class="relative hidden lg:block">
            <div class="title absolute invisible">Share on whatsapp</div>
            <a
                href={"https://web.whatsapp.com/send?text=" +
                    pageTitle +
                    " | " +
                    Astro.url}
                class="size-7 rounded-full bg-lite-green hover:bg-dark-green flex justify-center items-center hover:scale-105 transition-all ease-in-out duration-300"
            >
                <i class="fa-brands fa-whatsapp"></i>
            </a>
        </li>
        <li class="relative lg:hidden">
            <div class="title absolute invisible">Share on whatsapp</div>
            <a
                href={"https://api.whatsapp.com/send?text=" +
                    pageTitle +
                    " | " +
                    Astro.url}
                class="size-7 rounded-full bg-lite-green hover:bg-dark-green flex justify-center items-center hover:scale-105 transition-all ease-in-out duration-300"
            >
                <i class="fa-brands fa-whatsapp"></i>
            </a>
        </li>
        <li class="relative">
            <div class="title absolute invisible">Share on pinterest</div>
            <a
                href={"https://www.pinterest.com/pin/create/button/?url=" +
                    Astro.url +
                    "&media=" +
                    Astro.url.origin+"/"+pageFeaturedImage +
                    "&description=" +
                    pageTitle}
                class="size-7 rounded-full bg-lite-green hover:bg-dark-green flex justify-center items-center hover:scale-105 transition-all ease-in-out duration-300"
            >
                <i class="fa-brands fa-pinterest-p"></i>
            </a>
        </li>
        <li class="relative">
            <div class="title absolute invisible">Share on linkedin</div>
            <a
                href={"https://www.linkedin.com/shareArticle?url=" + Astro.url}
                class="size-7 rounded-full bg-lite-green hover:bg-dark-green flex justify-center items-center hover:scale-105 transition-all ease-in-out duration-300"
            >
                <i class="fa-brands fa-linkedin-in"></i>
            </a>
        </li>
        <li class="relative">
            <div class="title absolute invisible">Copy Link</div>
            <button onclick="copyCurrentPageURL()" aria-label="Copy URL Button"
                class="size-7 rounded-full bg-lite-green hover:bg-dark-green flex justify-center items-center hover:scale-105 transition-all ease-in-out duration-300"
            >
                <i class="fa-solid fa-paperclip"></i>
            </button>
        </li>
        <li class="relative">
            <div class="title absolute invisible">Share</div>
            <button onclick="triggerPageShare()" aria-label="Share"
                class="size-7 rounded-full bg-lite-green hover:bg-dark-green flex justify-center items-center hover:scale-105 transition-all ease-in-out duration-300"
            >
                <i class="fa-solid fa-share"></i>
            </button>
        </li>
    </ul>
</div>

<script is:inline>
function copyCurrentPageURL() {
    const currentURL = window.location.href; // Get the current page URL
    
    navigator.clipboard.writeText(currentURL)
    .then(() => {
        console.log('URL copied to clipboard!');
        showNotification('The page URL has been copied to your clipboard.');
        // alert('The page URL has been copied to your clipboard.');
      })
      .catch(err => {
        console.error('Failed to copy the URL: ', err);
        alert('Failed to copy the URL.');
      });
}

async function triggerPageShare() {
    await navigator.share({
        title: document.querySelector("title").innerText,
        text: document.querySelector("title").innerText,
        url: window.location.href
    });
}
</script>