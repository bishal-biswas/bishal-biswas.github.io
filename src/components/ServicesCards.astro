---
// Homepage services block. Cards come from the `services` content collection
// (src/content/services/), so adding a service in the CMS adds it here and on
// /services with no code change.
import { getCollection } from "astro:content";
import { offeredServices } from "../data/site-data/skills";
import { filterDrafts, getEntrySlug } from "../data/utils";

import ButtonLinkUI from "./ButtonLinkUI.astro";
import HeadingText from "./headingText.astro";
import LinksPlaceHolder from "./linksPlaceHolder.astro";
import ServiceCard from "./ServiceCard.astro";

const services = filterDrafts(await getCollection("services")).sort(
    (a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title),
);
---

{
    services.length > 0 && (
        <div class="about mt-14">
            <HeadingText headText={offeredServices.titleText} />

            {offeredServices.introText && <p class="mt-6 text-sm dark:text-font-gray">{offeredServices.introText}</p>}

            <div class="serviceCardsHolder mt-10 flex flex-wrap justify-between items-stretch gap-7">
                {services.map(({ data }) => (
                    <ServiceCard
                        href={`/services/${getEntrySlug(data)}/`}
                        title={data.title}
                        iconClass={data.iconClass}
                        shortDescription={data.shortDescription}
                        points={data.servicePoints}
                        startingPrice={data.startingPrice || data.pricingPlans[0]?.price}
                    />
                ))}
            </div>

            <LinksPlaceHolder Classes="my-5 gap-3">
                <ButtonLinkUI action="/services" iconClass="fa-solid fa-arrow-right">{offeredServices.viewAllText || "View all services"}</ButtonLinkUI>
                <ButtonLinkUI action="https://www.upwork.com/freelancers/~0115a5e68520f6bde9" isBgColored={true} iconClass="text-xl fa-brands fa-upwork">Available on Upwork</ButtonLinkUI>
            </LinksPlaceHolder>
        </div>
    )
}
