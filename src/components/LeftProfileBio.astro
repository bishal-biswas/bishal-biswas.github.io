---
/* import { Image } from "astro:assets";
import myImportedImage from '../../src/assets/images/ProPic.jpg'; */

import { personalFiles } from "../data/site-data/personalFiles";
import { personaInfo } from "../data/site-data/profile";
import { calculateAge } from "../data/utils";
import { getPaths } from "../data/utils";

import ButtonLinkUI from "./ButtonLinkUI.astro";
import ContactForm from "./ContactForm.astro";
import SectionDivider from "./SectionDivider.astro";
import TypewriterText from "./TypewriterText.astro"

const personInfo = personaInfo;

---

<div class="hidden lg:block w-[400px]"></div>
<div class="left-profile lg:fixed top-28 flex flex-col justify-center items-center gap-6 p-5 px-10 dark:bg-dark-teal bg-dark-teal rounded-xl lg:w-[400px] w-full h-fit shadow-md shadow-[#000000be]">
    <div class="profile-data flex flex-col justify-center items-center gap-3">
        <span class="relative flex justify-center items-center">
            <span class="size-[85px] lg:size-[105px] absolute shadow-lg shadow-lite-green bg-lite-green rounded-full block z-0 animate-spin"></span>
            
            <!-- <Image
                src={myImportedImage}
                alt="profile photo"
                width="110"
                height="110"
                class="rounded-full relative size-20 lg:size-28 border-2 border-lite-green z-[1]"
            /> -->
            <img
                src={personalFiles.profilePicture}
                alt="profile photo"
                class="rounded-full relative size-20 lg:size-28 border-2 border-lite-green z-[1]"
            />
            
            <span class="isOnline border-2 select-none dark:border-dark-green rounded-full grid place-items-center absolute z-[1] bg-lite-green size-4 bottom-2 lg:right-3 right-0 lg:hover:right-2 hover:-right-2 hover:w-auto hover:h-auto group transition-all ease-in-out cursor-default">
                <span class="invisible w-0 px-1 text-center text-xs group-hover:visible group-hover:min-w-[97px]">{personInfo.statusText}</span>
            </span>
            
        </span>
        <span class="Name font-bold text-xl">{personInfo.fullName}</span>
    </div>
    <TypewriterText typeWriterContents={personInfo.typeWriterText}/>

    <SectionDivider isVerticallySpaced={false} />
    
    <ul class="socials flex gap-5 flex-wrap text-lg">
        {
            personInfo.socialLinks.map((link)=>(
                <li><a aria-label={"Link to " + link.title} class="hover:text-lite-green" href={link.url}><i class:list={[link.iconClass]}></i></a></li>
            ))
        }
    </ul>

    <SectionDivider isVerticallySpaced={false} />

    <ul class="personalInfo w-full text-sm uppercase leading-7">
        {
            personInfo.residence &&
            <li class="flex justify-between">
                <span class="parameter font-semibold">Residence:</span>
                <span class="value dark:text-font-gray text-font-gray">{personInfo.residence}</span>
            </li>
        }
        {
            personInfo.City &&
            <li class="flex justify-between">
                <span class="parameter font-semibold">City</span>
                <span class="value dark:text-font-gray text-font-gray">{personInfo.City}</span>
            </li>
        }
        {
            personInfo.DOB &&
            <li class="flex justify-between">
                <span class="parameter font-semibold">Age:</span>
                <span class="value dark:text-font-gray text-font-gray">{calculateAge(personInfo.DOB, new Date())}</span>
            </li>
        }
    </ul>

    <SectionDivider isVerticallySpaced={false} />
    
    <div class="CTA flex justify-center items-center">
        <ButtonLinkUI ariaLabel="Send Message" isButton={true} isBgColored={true} id="messageBtn" iconClass="fa-solid fa-paper-plane">Leave a Message</ButtonLinkUI>
    </div>
</div>

<!--
    The real <ContactForm />, parked out of sight until #messageBtn hands it to
    the modal. Rendering the component here - instead of pasting a lookalike
    into modalContent - is what makes the modal copy actually send: its own
    script runs on page load and binds it to siteApi, exactly like /contact.
-->
<div class="hidden">
    <div
        id="contactModalPanel"
        tabindex="-1"
        data-modal-labelledby="contactModalTitle"
        class="relative dark:bg-dark-teal bg-dark-teal dark:text-font-white text-teal-white text-left rounded-lg shadow-xl outline-none p-5 sm:p-6"
    >
        <button
            type="button"
            data-modal-close
            aria-label="Close"
            class="absolute -top-4 -right-4 text-lg size-8 cursor-pointer rounded-full bg-lite-green p-1 text-white grid place-items-center hover:scale-110"
        >
            <i class="fa-solid fa-xmark"></i>
        </button>

        <h3 id="contactModalTitle" class="text-lg font-medium leading-6 text-lite-green">Leave a Message</h3>

        <ContactForm formId="modal-contact-form" containerClass="mt-4" />
    </div>
</div>

<script is:inline>
    const messageBtn = document.querySelector("#messageBtn");

    if (messageBtn) {
        messageBtn.addEventListener("click", () => {
            openModalPanel("contactModalPanel");
        });
    }
</script>
